                                    <span class="badge bg-primary ms-1">Padrão</span>
                                <?php endif ?>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis border"><?=htmlspecialchars($m->tipo_demonstrativo, ENT_QUOTES, "UTF-8")?></span></td>
