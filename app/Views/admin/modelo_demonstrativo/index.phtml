                                <?php if ($permissao["excluir"] && !$m->is_padrao) : ?>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Excluir"
                                        onclick="confirmDeleteUrl('<?=$router->route("admin.modelo.demonstrativo.delete", ["id" => $m->id])?>')">
                                        <i class="uil uil-trash" style="font-size:.8rem"></i>
                                    </button>
                                <?php endif ?>
                            </td>
