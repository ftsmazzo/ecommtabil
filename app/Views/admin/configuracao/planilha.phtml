<?php $this->layout("app/template/base");

$destinosEspeciais = (array) ($destinosEspeciais ?? []);
$contas            = (array) ($contas ?? []);

$optionsCampoDre = function (?string $atual = "") use ($destinosEspeciais, $contas): string {
    $atual = (string) $atual;
    $html  = '<option value="">— Selecione —</option>';
    $html .= '<optgroup label="Campos do lançamento">';
    foreach ($destinosEspeciais as $valor => $label) {
        $sel = $atual === (string) $valor ? " selected" : "";
        $html .= '<option value="' . htmlspecialchars((string) $valor, ENT_QUOTES, "UTF-8") . '"' . $sel . ">"
            . htmlspecialchars((string) $label, ENT_QUOTES, "UTF-8") . "</option>";
    }
    $html .= "</optgroup>";
    foreach ($contas as $raiz => $grupo) {
        $html .= '<optgroup label="' . htmlspecialchars((string) $raiz, ENT_QUOTES, "UTF-8") . '">';
        foreach ($grupo as $conta) {
            $valor = "conta_" . $conta->id;
            $sel   = $atual === $valor ? " selected" : "";
            $rotulo = trim((string) $conta->codigo . " — " . (string) $conta->nome);
            $html .= '<option value="' . htmlspecialchars($valor, ENT_QUOTES, "UTF-8") . '"' . $sel . ">"
                . htmlspecialchars($rotulo, ENT_QUOTES, "UTF-8") . "</option>";
        }
        $html .= "</optgroup>";
    }
    return $html;
};
?>

