<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
(function () {
    const body  = document.getElementById("colunas-body");
    const letras = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

    function reindex() {
        Array.from(body.querySelectorAll("tr")).forEach(function (tr, i) {
            const letra = tr.querySelector(".col-letra");
            if (letra) letra.textContent = letras[i] || ("Col" + (i + 1));
            tr.querySelectorAll("input, select").forEach(function (el) {
                el.name = el.name.replace(/\[\d+\]/, "[" + i + "]");
            });
        });
    }

    Sortable.create(body, {
        handle: ".col-handle",
        animation: 150,
        onEnd: reindex,
    });

    let nextIdx = <?=count($colunas)?>;

    const campoDreOptions = <?=json_encode($optionsCampoDre(""), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP)?>;

    document.getElementById("btn-add-coluna").addEventListener("click", function () {
        const empty = document.getElementById("empty-row");
        if (empty) empty.remove();

        const i  = nextIdx++;
        const tr = document.createElement("tr");
        tr.innerHTML =
            '<td class="col-handle align-middle"><i class="uil uil-draggabledots"></i></td>' +
            '<td class="align-middle text-center col-letra">' + (letras[i] || "Col" + (i + 1)) + '</td>' +
            '<td><input type="text" name="descricao[' + i + ']" class="form-control form-control-sm" required placeholder="Ex: Receita Bruta"></td>' +
            '<td><input type="text" name="helper[' + i + ']" class="form-control form-control-sm" placeholder="Ex.: Data da venda"></td>' +
            '<td><select name="campo_dre[' + i + ']" class="form-select form-select-sm">' + campoDreOptions + '</select></td>' +
            '<td class="text-end align-middle"><button type="button" class="btn btn-sm btn-link text-danger btn-remove-coluna" title="Remover"><i class="uil uil-trash"></i></button></td>';
        body.appendChild(tr);
    });

    body.addEventListener("click", function (e) {
        const btn = e.target.closest(".btn-remove-coluna");
        if (!btn) return;
        btn.closest("tr").remove();
        if (!body.querySelectorAll("tr").length) {
            body.innerHTML = '<tr id="empty-row"><td colspan="6" class="text-center text-muted py-4">Nenhuma coluna configurada.</td></tr>';
            nextIdx = 0;
        } else {
            reindex();
        }
    });
})();
</script>
<?php $this->end() ?>
