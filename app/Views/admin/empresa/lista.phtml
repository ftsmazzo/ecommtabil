<script type="text/javascript" src="<?=asset("dist/dizuploader/dizuploader.min.js")?>"></script>
<script>
    $(function () {
        const $arquivo     = $("#arquivo-importacao-empresas");
        const $btnDownload = $("#btn-download-modelo-empresas");
        const $form        = $("#modal-import-empresas form");
        const $submit      = $("#btn-enviar-importacao-empresas");

        if ($arquivo.length && $.fn.dizuploader) {
            $arquivo.dizuploader({
                caption: "Arraste e solte a planilha. Ou clique para selecionar.",
                extensions: ["xlsx", "xls", "csv"]
            });
        }

        $btnDownload.on("click", function () {
            const url = $(this).data("url");
            if (url) {
                const link = document.createElement("a");
                link.href = url;
                link.download = "";
                document.body.appendChild(link);
                link.click();
                link.remove();
            }
        });

        $form.on("submit", function () {
            if ($submit.length) {
                $submit.prop("disabled", true);
                $submit.find(".btn-text").addClass("d-none");
                $submit.find(".btn-loading").removeClass("d-none");
            }
        });
    });
</script>
<?php $this->end() ?>
