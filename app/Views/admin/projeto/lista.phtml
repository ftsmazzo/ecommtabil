<script>
document.getElementById('modal-editar-projeto')?.addEventListener('show.bs.modal', function (e) {
    var btn = e.relatedTarget;
    document.getElementById('edit-id').value         = btn.dataset.id;
    document.getElementById('edit-nome').value        = btn.dataset.nome;
    document.getElementById('edit-descricao').value   = btn.dataset.descricao;
    var sel = document.getElementById('edit-id-empresa');
    sel.value = btn.dataset.idEmpresa;
    if (window.jQuery) $(sel).selectpicker('val', btn.dataset.idEmpresa);
});
</script>
