<script>
$(function () {
    if ($.fn.dizuploader) {
        $("#arquivo-template").dizuploader({ caption: "Arraste e solte o arquivo ou clique para selecionar.", extensions: ["xlsx", "xls", "csv"] });
        $("#arquivo-livre").dizuploader({   caption: "Arraste e solte o arquivo ou clique para selecionar.", extensions: ["xlsx", "xls", "csv"] });
    }
    function setupFormSubmit($form, $btn) {
        $form.on("submit", function () {
            $btn.prop("disabled", true);
            $btn.find(".btn-text").addClass("d-none");
            $btn.find(".btn-loading").removeClass("d-none");
        });
    }
    setupFormSubmit($("#form-import-template"), $("#btn-enviar-template"));
    setupFormSubmit($("#form-import-livre"),    $("#btn-enviar-livre"));
});
</script>
