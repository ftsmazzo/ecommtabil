<script>
$(function () {
    if ($.fn.dizuploader) {
        $(".input-import-template, .input-import-livre").each(function () {
            $(this).dizuploader({ caption: "Arraste ou clique para selecionar.", extensions: ["xlsx", "xls", "csv"] });
        });
    }
    $(".form-import-template, .form-import-livre").on("submit", function () {
        var $btn = $(this).find("button[type=submit]");
        $btn.prop("disabled", true);
        $btn.find(".btn-text").addClass("d-none");
        $btn.find(".btn-loading").removeClass("d-none");
    });
});
</script>
