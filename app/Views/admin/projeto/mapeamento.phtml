$campos           = (array) ($campos ?? []);
$colunas          = (array) ($colunas ?? []);
$camposModelo     = (array) ($camposModelo ?? []);
$origem           = $origemMapeamento ?? "vazio";
$contaPadrao      = (int) ($contaPadrao ?? 0);
$anoBase          = (int) ($anoBase ?? date("Y"));
if ($anoBase < 1990 || $anoBase > 2100) {
    $anoBase = (int) date("Y");
}

$contasPlanas = [];
foreach ((array) ($contas ?? []) as $grupo) {
    foreach ($grupo as $conta) {
        $contasPlanas[] = $conta;
    }
}

$abrirContas = false;
foreach ($campos as $dest => $idx) {
    if (str_starts_with((string) $dest, "conta_")) {
        $abrirContas = true;
        break;
    }
}

$nomeContaPorId = [];
foreach ($contasPlanas as $c) {
    $nomeContaPorId[(int) $c->id] = trim((string) $c->codigo . " — " . (string) $c->nome);
}

$rotuloDestino = static function (string $dest) use ($nomeContaPorId): string {
    return match ($dest) {
        "__periodo__"   => "Data / competência",
        "__descricao__" => "Descrição / título",
        "__valor__"     => "Valor único",
        "__unidade__"   => "Marketplace / unidade",
        "__conta__"     => "Conta (texto da linha)",
        default         => (preg_match('/^conta_(\d+)$/', $dest, $m) && isset($nomeContaPorId[(int) $m[1]]))
            ? $nomeContaPorId[(int) $m[1]]
            : $dest,
    };
};

$colunasUsadas = array_map("intval", array_values($campos));

$destinosJa = array_column($camposModelo, "destino");
foreach ($campos as $dest => $idx) {
    $dest = (string) $dest;
    if (!str_starts_with($dest, "conta_")) {
        continue;
    }
    if (in_array($dest, $destinosJa, true)) {
        continue;
    }
    $camposModelo[] = [
        "destino" => $dest,
        "label"   => $rotuloDestino($dest),
        "hint"    => "Coluna de valor da planilha (receita, custo, tarifa…)",
    ];
    $destinosJa[] = $dest;
}
$abrirContas = true;

$mapperUi = new \App\Services\Importacao\DeParaMapper();
$colunasMatrizCandidatas = [];
foreach ($colunas as $i => $col) {
    $n = $mapperUi->normalizar((string) ($col["header"] ?? ""));
    if ($mapperUi->pareceCabecalhoPeriodo($n) || in_array((int) $i, $periodosMarcados, true)) {
        $colunasMatrizCandidatas[(int) $i] = $col;
    }
}
$layoutAtual = (string) ($layoutDetectado ?? $layout ?? "");
$mostrarMatriz = $layoutAtual === "matriz" || $colunasMatrizCandidatas !== [] || $periodosMarcados !== [];

$renderSelect = function (string $destino, bool $obrigatorio = false) use ($colunas, $campos): void {
    $atual = array_key_exists($destino, $campos) ? (string) (int) $campos[$destino] : "";
    $req   = $obrigatorio ? " data-obrigatorio=\"1\"" : "";
    echo '<select name="campos[' . htmlspecialchars($destino, ENT_QUOTES, "UTF-8") . ']" class="form-select form-select-sm map-select js-col"' . $req . '>';
    echo '<option value="">— Qual coluna da planilha? —</option>';
    foreach ($colunas as $i => $col) {
        $sel = ($atual !== "" && (int) $atual === (int) $i) ? " selected" : "";
        echo '<option value="' . (int) $i . '"' . $sel . '>' . htmlspecialchars((string) $col["label"], ENT_QUOTES, "UTF-8") . "</option>";
    }
    echo "</select>";
};
?>

