<?php
$this->layout("app/template/base");

$qtdSalvos        = count(array_filter((array) ($mapeamentoSalvo ?? [])));
$periodosMarcados = array_map("intval", (array) ($periodosMatriz ?? []));
$campos           = (array) ($campos ?? []);
$colunas          = (array) ($colunas ?? []);
$camposModelo     = (array) ($camposModelo ?? []);
$origem           = $origemMapeamento ?? "vazio";
$contaPadrao      = (int) ($contaPadrao ?? 0);
$anoBase          = (int) ($anoBase ?? date("Y"));
if ($anoBase < 1990 || $anoBase > 2100) {
    $anoBase = (int) date("Y");
}

$contasPlanas = [];
foreach ((array) ($contas ?? []) as $grupo) {
    foreach ($grupo as $conta) {
        $contasPlanas[] = $conta;
    }
}

$temContaN = false;
foreach ($campos as $dest => $_) {
    if (str_starts_with((string) $dest, "conta_")) {
        $temContaN = true;
        break;
    }
}

$layoutAtual   = (string) ($layoutDetectado ?? $layout ?? "");
$mostrarMatriz = $layoutAtual === "matriz" || $periodosMarcados !== [];

$principais = [];
$opcionais  = [];
foreach ($camposModelo as $campo) {
    $destCampo = (string) ($campo["destino"] ?? "");
    if ($destCampo === "__valor__" && $temContaN) {
        continue;
    }
    $mapped = array_key_exists($destCampo, $campos);
    $puxar  = $mapped
        || !empty($campo["obrigatorio"])
        || !empty($campo["esperado"]);
    if ($puxar) {
        $principais[] = $campo;
    } else {
        $opcionais[] = $campo;
    }
}

$temData = array_key_exists("__periodo__", $campos);
$podeProcessar = $temData && $temContaN;

$renderSelect = function (string $destino) use ($colunas, $campos): void {
    $atual = array_key_exists($destino, $campos) ? (string) (int) $campos[$destino] : "";
    echo '<select name="campos[' . htmlspecialchars($destino, ENT_QUOTES, "UTF-8") . ']" class="form-select form-select-sm map-select js-col">';
    echo '<option value="">— Nenhuma coluna do cliente —</option>';
    foreach ($colunas as $i => $col) {
        $sel = ($atual !== "" && (int) $atual === (int) $i) ? " selected" : "";
        echo '<option value="' . (int) $i . '"' . $sel . '>' . htmlspecialchars((string) $col["label"], ENT_QUOTES, "UTF-8") . "</option>";
    }
    echo "</select>";
};

$renderLinhaModelo = function (array $campo) use ($renderSelect, $campos): void {
    $destCampo = (string) $campo["destino"];
    $mapped = array_key_exists($destCampo, $campos);
    echo '<tr class="js-modelo-row' . ($mapped ? " map-preenchida" : "") . '" data-busca="' . htmlspecialchars((string) ($campo["busca"] ?? $campo["label"]), ENT_QUOTES, "UTF-8") . '">';
    echo '<td>';
    echo '<div class="campo-label">' . htmlspecialchars((string) $campo["label"], ENT_QUOTES, "UTF-8");
    if (!empty($campo["obrigatorio"])) {
        echo ' <span class="badge text-bg-danger">obrigatório</span>';
    } elseif ($mapped) {
        echo ' <span class="badge text-bg-success">encaixado</span>';
    } elseif (!empty($campo["esperado"])) {
        echo ' <span class="badge text-bg-warning">esperado nesta planilha</span>';
    } else {
        echo ' <span class="badge text-bg-light text-muted">vazio ok</span>';
    }
    echo '</div>';
    if (!empty($campo["hint"])) {
        echo '<div class="campo-hint">' . htmlspecialchars((string) $campo["hint"], ENT_QUOTES, "UTF-8") . "</div>";
    }
    if (!empty($campo["exemplos"])) {
        echo '<div class="campo-hint">No arquivo do cliente, procure: <strong>' . htmlspecialchars((string) $campo["exemplos"], ENT_QUOTES, "UTF-8") . "</strong></div>";
    }
    echo "</td><td>";
    $renderSelect($destCampo);
    echo "</td></tr>";
};
?>

