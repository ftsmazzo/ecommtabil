                                    <th>Linha do Excel</th>
                                    <th>Coluna da planilha</th>
                                    <th>Conta no plano</th>
                                    <th>Data</th>
                                    <th class="text-end">Valor</th>
                                </tr>
                            </thead>
                            <tbody id="simular-tbody"></tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">Amostra das primeiras linhas. Nada foi gravado ainda.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<?php $this->start("endScripts") ?>
<script>
(function () {
    var abaAtiva = <?=(int) $abaAtiva?>;
    var previewUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear.preview", ["id" => $projeto->id]))?>;
    var mapeamentoUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear", ["id" => $projeto->id]))?>;
    var sugerirUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear.sugerir", ["id" => $projeto->id]))?>;
    var simularUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear.simular", ["id" => $projeto->id]))?>;
    var previewLoaded = {};
    var form = document.getElementById("form-mapeamento");

    function destacarLinhas() {
        document.querySelectorAll("select.js-col").forEach(function (sel) {
            var tr = sel.closest("tr");
            if (tr) tr.classList.toggle("map-preenchida", !!sel.value);
        });
    }

    function enforceUnique(origem) {
        var val = origem.value;
        if (!val) {
            destacarLinhas();
            return;
        }
        document.querySelectorAll("select.js-col").forEach(function (sel) {
            if (sel !== origem && sel.value === val) sel.value = "";
        });
        document.querySelectorAll("input.js-matriz").forEach(function (cb) {
            if (cb.value === val) cb.checked = false;
        });
        destacarLinhas();
    }

    form.addEventListener("change", function (ev) {
        if (ev.target && ev.target.classList.contains("js-col")) {
            enforceUnique(ev.target);
        }
        if (ev.target && ev.target.classList.contains("js-matriz") && ev.target.checked) {
            document.querySelectorAll("select.js-col").forEach(function (sel) {
                if (sel.value === ev.target.value) sel.value = "";
            });
            destacarLinhas();
        }
    });

    destacarLinhas();

    function loadPreview(abaIdx) {
        if (previewLoaded[abaIdx]) return;
        document.getElementById("preview-loading").classList.remove("d-none");
        document.getElementById("preview-table-wrap").classList.add("d-none");
        document.getElementById("preview-error").classList.add("d-none");

        fetch(previewUrl, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "csrf=<?=$csrf?>&aba=" + abaIdx,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            document.getElementById("preview-loading").classList.add("d-none");
            if (data.error) {
                document.getElementById("preview-error").textContent = data.message;
                document.getElementById("preview-error").classList.remove("d-none");
                return;
            }
            var tbl = document.getElementById("preview-table");
            tbl.innerHTML = "";
            data.rows.forEach(function (row, ri) {
                var tr = document.createElement("tr");
                if (ri === 0) tr.style.cssText = "background:#1e3a5f;color:#fff;font-weight:600";
                row.forEach(function (cell) {
                    var td = document.createElement(ri === 0 ? "th" : "td");
                    td.textContent = cell;
                    tr.appendChild(td);
                });
                tbl.appendChild(tr);
            });
            document.getElementById("preview-table-wrap").classList.remove("d-none");
            previewLoaded[abaIdx] = true;
        })
        .catch(function () {
            document.getElementById("preview-loading").classList.add("d-none");
            document.getElementById("preview-error").textContent = "Erro ao carregar pré-visualização.";
            document.getElementById("preview-error").classList.remove("d-none");
        });
    }

    document.getElementById("offcanvas-preview").addEventListener("show.bs.offcanvas", function () {
        loadPreview(abaAtiva);
    });

    var selAba = document.getElementById("sel-aba");
    if (selAba) {
        selAba.addEventListener("change", function () {
            window.location = mapeamentoUrl + "?aba=" + parseInt(this.value, 10);
        });
    }

    var btnProc = document.getElementById("btn-processar");
    if (btnProc) {
        btnProc.closest("form").addEventListener("submit", function () {
            btnProc.disabled = true;
            btnProc.querySelector(".btn-text").classList.add("d-none");
            btnProc.querySelector(".btn-loading").classList.remove("d-none");
        });
    }

    var btnIa = document.getElementById("btn-ia-sugerir");
    if (btnIa) {
        btnIa.addEventListener("click", function () {
            var feedback = document.getElementById("ia-feedback");
            btnIa.disabled = true;
            btnIa.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analisando...';
            feedback.className = "ms-2 small d-none";

            var body = "csrf=<?=$csrf?>&aba=" + abaAtiva;
            document.querySelectorAll("input[name^='headers[']").forEach(function (inp) {
                body += "&" + encodeURIComponent(inp.name) + "=" + encodeURIComponent(inp.value);
            });
            document.querySelectorAll("select.js-col").forEach(function (sel) {
                if (!sel.value) return;
                var m = sel.name.match(/^campos\[(.+)\]$/);
                if (!m) return;
                body += "&" + encodeURIComponent("campos_atuais[" + m[1] + "]") + "=" + encodeURIComponent(sel.value);
            });
            document.querySelectorAll("input.js-matriz:checked").forEach(function (cb) {
                body += "&periodos_atuais[]=" + encodeURIComponent(cb.value);
            });

            fetch(sugerirUrl, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: body,
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btnIa.disabled = false;
                btnIa.innerHTML = '<i class="uil uil-bolt me-1"></i>Completar automaticamente';

                if (!data.ok) {
                    feedback.textContent = "Erro: " + (data.error || "falha desconhecida");
                    feedback.className = "ms-2 small text-danger";
                    return;
                }

                var aplicados = 0;
                var campos = data.campos || {};
                var usadas = {};
                document.querySelectorAll("select.js-col").forEach(function (sel) {
                    if (sel.value) usadas[sel.value] = true;
                });
                Object.keys(campos).forEach(function (dest) {
                    var sel = form.querySelector('select[name="campos[' + dest + ']"]');
                    if (!sel) return;
                    if (sel.value !== "") return;
                    var idx = String(campos[dest]);
                    if (usadas[idx]) return;
                    sel.value = idx;
                    if (sel.value !== "") {
                        usadas[idx] = true;
                        aplicados++;
                    }
                });

                var periodos = (data.periodos_matriz || []).map(function (n) { return String(n); });
                document.querySelectorAll("input.js-matriz").forEach(function (cb) {
                    if (cb.checked) return;
                    if (periodos.indexOf(String(cb.value)) === -1) return;
                    if (usadas[String(cb.value)]) return;
                    cb.checked = true;
                    aplicados++;
                });

                destacarLinhas();

                var extra = data.aviso ? " " + data.aviso : "";
                if (aplicados > 0) {
                    feedback.textContent = aplicados + " lacuna(s) preenchida(s). Nada do que já estava certo foi trocado." + extra;
                    feedback.className = "ms-2 small text-success";
                } else {
                    feedback.textContent = "Nada novo para preencher." + extra;
                    feedback.className = "ms-2 small text-muted";
                }
            })
            .catch(function () {
                btnIa.disabled = false;
                btnIa.innerHTML = '<i class="uil uil-bolt me-1"></i>Completar automaticamente';
                document.getElementById("ia-feedback").textContent = "Erro de conexão.";
                document.getElementById("ia-feedback").className = "ms-2 small text-danger";
            });
        });
    }

    var filtro = document.getElementById("filtro-contas");
    if (filtro) {
        filtro.addEventListener("input", function () {
            var q = (filtro.value || "").toLowerCase().trim();
            document.querySelectorAll(".js-conta-row").forEach(function (tr) {
                var busca = tr.getAttribute("data-busca") || "";
                tr.classList.toggle("d-none", q !== "" && busca.indexOf(q) === -1);
            });
        });
    }

    var btnSimular = document.getElementById("btn-simular");
    if (btnSimular) {
        btnSimular.addEventListener("click", function () {
            var modalEl = document.getElementById("modal-simular");
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            document.getElementById("simular-loading").classList.remove("d-none");
            document.getElementById("simular-erro").classList.add("d-none");
            document.getElementById("simular-ok").classList.add("d-none");
            modal.show();

            fetch(simularUrl, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "csrf=<?=$csrf?>&aba=" + abaAtiva,
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                document.getElementById("simular-loading").classList.add("d-none");
                if (!data.ok) {
                    document.getElementById("simular-erro").textContent = data.error || "Falha na simulação.";
                    document.getElementById("simular-erro").classList.remove("d-none");
                    return;
                }
                var orig = data.linhas_origem || data.inseridos;
                document.getElementById("simular-resumo").textContent =
                    orig + " linha(s) da planilha → " + data.inseridos + " lançamento(s) (uma coluna de valor = um lançamento) · " +
                    data.ignorados + " linha(s) sem valor mapeado · " +
                    (data.contas_nao_achadas ? data.contas_nao_achadas.length : 0) + " conta(s) sem match.";

                var avisos = document.getElementById("simular-avisos");
                avisos.innerHTML = "";
                (data.avisos || []).forEach(function (aviso) {
                    var d = document.createElement("div");
                    d.className = "alert alert-warning py-2 small";
                    d.textContent = aviso;
                    avisos.appendChild(d);
                });

                var tb = document.getElementById("simular-tbody");
                tb.innerHTML = "";
                (data.amostras || []).forEach(function (a) {
                    var tr = document.createElement("tr");
                    var valorNum = Number(a.valor || 0);
                    var valor = valorNum.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    if (valorNum < 0) {
                        tr.classList.add("text-danger");
                    }
                    tr.innerHTML = "<td></td><td></td><td></td><td></td><td class=\"text-end\"></td>";
                    tr.cells[0].textContent = a.linha;
                    tr.cells[1].textContent = a.origem || "—";
                    tr.cells[2].textContent = a.conta || "";
                    tr.cells[3].textContent = a.periodo || "—";
                    tr.cells[4].textContent = valor;
                    tb.appendChild(tr);
                });
                document.getElementById("simular-ok").classList.remove("d-none");
            })
            .catch(function () {
                document.getElementById("simular-loading").classList.add("d-none");
                document.getElementById("simular-erro").textContent = "Erro de conexão.";
                document.getElementById("simular-erro").classList.remove("d-none");
            });
        });
    }
})();
</script>
<?php $this->end() ?>
