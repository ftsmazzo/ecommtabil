<?php $this->start("endScripts") ?>
<script>
(function () {
    var uploadId    = <?=(int) $projeto->id?>;
    var abaAtiva    = <?=(int) $abaAtiva?>;
    var previewUrl  = <?=json_encode($router->route("admin.projeto.importacao.mapear.preview", ["id" => $projeto->id]))?>;
    var mapeamentoUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear", ["id" => $projeto->id]))?>;
    var previewLoaded = {};

    function loadPreview(abaIdx) {
        if (previewLoaded[abaIdx]) return;

        document.getElementById("preview-loading").classList.remove("d-none");
        document.getElementById("preview-table-wrap").classList.add("d-none");
        document.getElementById("preview-error").classList.add("d-none");

        fetch(previewUrl, {
            method:  "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body:    "csrf=<?=$csrf?>&aba=" + abaIdx,
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            document.getElementById("preview-loading").classList.add("d-none");
            if (data.error) {
                document.getElementById("preview-error").textContent = data.message;
                document.getElementById("preview-error").classList.remove("d-none");
                return;
            }
            var tbl  = document.getElementById("preview-table");
            tbl.innerHTML = "";
            data.rows.forEach(function (row, ri) {
                var tr = document.createElement("tr");
                if (ri === 0) tr.style.cssText = "background:#1e3a5f;color:#fff;font-weight:600";
                row.forEach(function (cell) {
                    var td = document.createElement(ri === 0 ? "th" : "td");
                    td.textContent = cell;
                    tr.appendChild(td);
                });
                tbl.appendChild(tr);
            });
            document.getElementById("preview-table-wrap").classList.remove("d-none");
            previewLoaded[abaIdx] = true;
        })
        .catch(function () {
            document.getElementById("preview-loading").classList.add("d-none");
            document.getElementById("preview-error").textContent = "Erro ao carregar pré-visualização.";
            document.getElementById("preview-error").classList.remove("d-none");
        });
    }

    // Carrega preview quando offcanvas abre
    document.getElementById("offcanvas-preview").addEventListener("show.bs.offcanvas", function () {
        loadPreview(abaAtiva);
    });

    // Troca de aba — recarrega headers e preview
    var selAba = document.getElementById("sel-aba");
    if (selAba) {
        selAba.addEventListener("change", function () {
            abaAtiva = parseInt(this.value);
            window.location = mapeamentoUrl + "?aba=" + abaAtiva;
        });
    }

    // Processar dados — loading
    var btnProc = document.getElementById("btn-processar");
    if (btnProc) {
        btnProc.closest("form").addEventListener("submit", function () {
            btnProc.disabled = true;
            btnProc.querySelector(".btn-text").classList.add("d-none");
            btnProc.querySelector(".btn-loading").classList.remove("d-none");
        });
    }

    // Sugerir mapeamento via IA
    var btnIa = document.getElementById("btn-ia-sugerir");
    if (btnIa) {
        var sugerirUrl = <?=json_encode($router->route("admin.projeto.importacao.mapear.sugerir", ["id" => $projeto->id]))?>;

        btnIa.addEventListener("click", function () {
            var feedback = document.getElementById("ia-feedback");
            btnIa.disabled = true;
            btnIa.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analisando...';
            feedback.className = "ms-2 small d-none";

            // Coleta os headers dos inputs hidden
            var body = "csrf=<?=$csrf?>&aba=" + abaAtiva;
            document.querySelectorAll("input[name^='headers[']").forEach(function (inp) {
                body += "&" + encodeURIComponent(inp.name) + "=" + encodeURIComponent(inp.value);
            });

            fetch(sugerirUrl, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: body,
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btnIa.disabled = false;
                btnIa.innerHTML = '<i class="ti ti-sparkles me-1"></i>Sugerir mapeamento';

                if (!data.ok) {
                    feedback.textContent = "Erro: " + (data.error || "falha desconhecida");
                    feedback.className = "ms-2 small text-danger";
                    return;
                }

                var aplicados = 0;
                Object.keys(data.sugestoes).forEach(function (idx) {
                    var val = data.sugestoes[idx];
                    if (!val) return;
                    var sel = document.querySelector("select[name='mapeamento[" + idx + "]']");
                    if (sel) {
                        // Verifica se a opção existe no select antes de aplicar
                        var exists = Array.from(sel.options).some(function (o) { return o.value === val; });
                        if (exists) {
                            sel.value = val;
                            // Destaca a linha visualmente
                            var tr = sel.closest("tr");
                            if (tr && !tr.classList.contains("table-success")) {
                                tr.classList.add("table-warning", "bg-opacity-50");
                            }
                            aplicados++;
                        }
                    }
                });

                if (aplicados > 0) {
                    feedback.textContent = aplicados + " sugestão(ões) aplicada(s). Revise e salve.";
                    feedback.className = "ms-2 small text-success";
                } else {
                    feedback.textContent = "Nenhuma sugestão pôde ser aplicada.";
                    feedback.className = "ms-2 small text-warning";
                }
            })
            .catch(function () {
                btnIa.disabled = false;
                btnIa.innerHTML = '<i class="ti ti-sparkles me-1"></i>Sugerir mapeamento';
                document.getElementById("ia-feedback").textContent = "Erro de conexão.";
                document.getElementById("ia-feedback").className = "ms-2 small text-danger";
            });
        });
    }
})();
</script>
<?php $this->end() ?>
