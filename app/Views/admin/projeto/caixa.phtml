<script src="<?=asset("dist/bootstrap-select/bootstrap-select.min.js")?>"></script>
<script>
(function () {
    if (window.jQuery) { $('.selectpicker').selectpicker(); }
    var modal = document.getElementById('modal-editar-mov');
    if (!modal) return;
    modal.addEventListener('show.bs.modal', function (ev) {
        var btn = ev.relatedTarget;
        if (!btn) return;
        document.getElementById('edit-mov-id').value = btn.getAttribute('data-mov-id') || '';
        document.getElementById('edit-mov-memo').textContent = btn.getAttribute('data-memo') || '';
        var conta = btn.getAttribute('data-conta') || '';
        var grupo = btn.getAttribute('data-grupo') || 'operacional';
        document.getElementById('edit-mov-grupo').value = grupo || 'operacional';
        document.getElementById('edit-mov-conta').value = conta || '';
    });
})();
</script>
<?php $this->end() ?>
