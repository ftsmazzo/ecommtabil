<script>
$(function () {
    if ($.fn.dizuploader) {
        $("#arquivo-importar").dizuploader({
            caption: "Arraste e solte o arquivo ou clique para selecionar.",
            extensions: ["xlsx", "xls", "csv"],
        });
    }
    $("#modal-importar-contas form").on("submit", function () {
        var btn = document.getElementById("btn-importar-contas");
        btn.disabled = true;
        btn.querySelector(".btn-text").classList.add("d-none");
        btn.querySelector(".btn-loading").classList.remove("d-none");
    });
});
</script>
