<ul class="dre-tree" data-tipo-conta="<?=htmlspecialchars($tipoConta, ENT_QUOTES, "UTF-8")?>">
    <?php foreach ($contas as $conta): ?>
        <li data-id="<?=$conta->id?>">
            <div class="dre-item">
                <span class="dre-codigo"><?=htmlspecialchars($conta->codigo, ENT_QUOTES, "UTF-8")?></span>
                <span class="dre-nome">
                    <?php if ($conta->natureza === "aumenta"): ?>
                        <span class="me-1 sinal-positivo">(A)</span>
                    <?php else: ?>
                        <span class="me-1 sinal-negativo">(D)</span>
                    <?php endif ?>
                    <?=htmlspecialchars($conta->nome, ENT_QUOTES, "UTF-8")?>
                </span>
                <div class="dre-actions">
                    <?php if ($permissao["editar"]): ?>
                        <a href="#" class="btn btn-sm btn-outline-secondary py-0 px-1"
                            title="Editar"
                            data-modal-ajax="<?=$router->route("admin.dre.conta.editar", ["id" => $conta->id])?>"
                            data-modal-target="#modal-dre-conta"
                            data-modal-title="Editar Conta">
                            <i class="uil uil-edit-alt" style="font-size:.8rem"></i>
                        </a>
                    <?php endif ?>
                    <?php if ($permissao["excluir"]): ?>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1"
                            title="Excluir"
                            onclick="confirmDeleteUrl('<?=$router->route("admin.dre.conta.delete", ["id" => $conta->id])?>')">
                            <i class="uil uil-trash" style="font-size:.8rem"></i>
                        </button>
                    <?php endif ?>
                </div>
            </div>
        </li>
    <?php endforeach ?>
</ul>
