<script>
document.addEventListener("DOMContentLoaded", function () {
    var modalRecarga = document.getElementById("modal-home-recarga");
    if (modalRecarga) {
        modalRecarga.addEventListener("shown.bs.modal", function () {
            if (typeof applyMasks === "function") {
                applyMasks($(modalRecarga));
            }

            var firstInput = modalRecarga.querySelector("#home-recarga-cartao");
            if (firstInput) {
                firstInput.focus();
                firstInput.select();
            }
        });

        var cardInput = modalRecarga.querySelector("#home-recarga-cartao");
        if (cardInput) {
            cardInput.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    var valueInput = modalRecarga.querySelector("#home-recarga-valor");
                    if (valueInput) {
                        valueInput.focus();
                        valueInput.select();
                    }
                }
            });
        }
    }

    var chartEl = document.getElementById("home-movements-chart");
    if (!chartEl || typeof echarts === "undefined") {
        if (chartEl && typeof echarts === "undefined") {
            chartEl.innerHTML = '<div class="home-chart-empty"><div><strong class="d-block mb-1">Grafico indisponivel</strong><span>O script do ECharts nao foi carregado.</span></div></div>';
        }
        return;
    }

    var chart = echarts.init(chartEl);
    var labels = <?= json_encode(array_map(static fn($item) => $item["label"] ?? "", $grafico), JSON_UNESCAPED_UNICODE) ?>;
    var recarga    = <?= json_encode(array_map(static fn($item) => (float) ($item["recarga"] ?? 0), $grafico), JSON_UNESCAPED_UNICODE) ?>;
    var cashback   = <?= json_encode(array_map(static fn($item) => (float) ($item["cashback"] ?? 0), $grafico), JSON_UNESCAPED_UNICODE) ?>;
    var fidelidade = <?= json_encode(array_map(static fn($item) => (float) ($item["fidelidade"] ?? 0), $grafico), JSON_UNESCAPED_UNICODE) ?>;

    chart.setOption({
        animationDuration: 500,
        grid: {
            left: 24,
            right: 24,
            top: 28,
            bottom: 24,
            containLabel: true
        },
        tooltip: {
            trigger: "axis",
            backgroundColor: "rgba(15, 23, 42, 0.92)",
            borderWidth: 0,
            textStyle: {
                color: "#fff"
            },
            axisPointer: {
                type: "shadow"
            },
            valueFormatter: function (value) {
                return "R$ " + Number(value || 0).toLocaleString("pt-BR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
        },
        legend: {
            show: false
        },
        xAxis: {
            type: "category",
            data: labels,
            axisTick: {
                show: false
            },
            axisLine: {
                lineStyle: {
                    color: "#dbe3ef"
                }
            },
            axisLabel: {
                color: "#64748b",
                fontWeight: 600
            }
        },
        yAxis: {
            type: "value",
            splitLine: {
                lineStyle: {
                    color: "#eef2f7"
                }
            },
            axisLabel: {
                color: "#94a3b8",
                formatter: function (value) {
                    return "R$ " + Number(value || 0).toLocaleString("pt-BR");
                }
            }
        },
        series: [
            {
                name: "Recarga",
                type: "bar",
                barMaxWidth: 18,
                itemStyle: {
                    color: "#2563eb",
                    borderRadius: [4, 4, 0, 0]
                },
                emphasis: {
                    itemStyle: {
                        color: "#1d4ed8"
                    }
                },
                data: recarga
            },
            {
                name: "Cashback",
                type: "bar",
                barMaxWidth: 18,
                itemStyle: {
                    color: "#16a34a",
                    borderRadius: [4, 4, 0, 0]
                },
                emphasis: {
                    itemStyle: {
                        color: "#15803d"
                    }
                },
                data: cashback
            },
            {
                name: "Fidelidade",
                type: "bar",
                barMaxWidth: 18,
                itemStyle: {
                    color: "#7c3aed",
                    borderRadius: [4, 4, 0, 0]
                },
                emphasis: {
                    itemStyle: {
                        color: "#6d28d9"
                    }
                },
                data: fidelidade
            }
        ]
    });

    window.addEventListener("resize", function () {
        chart.resize();
    });
});

if (new URLSearchParams(window.location.search).has("periodo")) {
    var anchor = document.getElementById("resumo-periodo");
    if (anchor) {
        anchor.scrollIntoView({ behavior: "smooth", block: "start" });
    }
}
</script>
