<?php if (empty($movimentacoes)) : ?>
    <p class="text-muted mb-0">Nenhuma movimentação registrada.</p>
<?php else : ?>
<div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>Data</th>
                <th>Tipo</th>
                <th class="text-end">Valor</th>
                <th class="text-end">Saldo após</th>
                <th>Forma</th>
                <th>Observação</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($movimentacoes as $mov) : ?>
            <tr>
                <td class="text-nowrap" data-order="<?= htmlspecialchars((string) ($mov->created_at ?? ''), ENT_QUOTES, 'UTF-8') ?>">
                    <small><?= $mov->data_print ?></small>
                </td>
                <td class="text-nowrap"><?= $mov->tipo_print ?><?= $mov->info_icon ?? '' ?></td>
                <td class="text-end text-nowrap">
                    <?= $mov->sentido_icon ?>
                    <?php if ($mov->is_credito === null) : ?>
                        <span class="fw-semibold"><?= $mov->valor_print ?></span>
                    <?php else : ?>
                        <span class="<?= $mov->is_credito ? 'text-success' : 'text-danger' ?> fw-semibold">
                            <?= $mov->valor_print ?>
                        </span>
                    <?php endif ?>
                </td>
                <td class="text-end text-nowrap">
                    <small class="text-muted"><?= $mov->saldo_print ?></small>
                </td>
                <td><small><?= $mov->forma_print ?></small></td>
                <td>
                    <small class="text-muted">
                        <?= htmlspecialchars((string) ($mov->observacao_print ?? $mov->descricao ?? ''), ENT_QUOTES, 'UTF-8') ?>
                    </small>
                </td>
            </tr>
            <?php endforeach ?>
        </tbody>
    </table>
</div>
<?php endif ?>
