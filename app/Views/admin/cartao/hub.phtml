<script>
(function () {
    var el = document.getElementById('saldo-display');
    if (!el) return;

    var target   = parseFloat(el.dataset.value) || 0;
    var duration = 900;
    var start    = null;

    function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

    function fmt(v) {
        return 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function tick(ts) {
        if (!start) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        el.textContent = fmt(target * easeOut(progress));
        if (progress < 1) requestAnimationFrame(tick);
    }

    el.textContent = fmt(0);
    requestAnimationFrame(tick);
})();
</script>

<?php $this->start("endScripts") ?>
<script>
$(document).ready(function () {
    var $form = $("#form-filtro-extrato");
    var $table = $("#table-extrato-cartao");
    var extratoTable = null;

    function applyExtratoFilter() {
        var tipoFiltro = ($("#extrato_tipo").val() || "").toString();
        var dataInicial = ($("#extrato_data_inicial").val() || "").toString();
        var dataFinal = ($("#extrato_data_final").val() || "").toString();

        if (!$table.length) {
            return;
        }

        $table.find("tbody tr").each(function () {
            var $row = $(this);
            var tipoRow = ($row.attr("data-tipo") || "").toString();
            var dataRow = ($row.attr("data-data") || "").toString();
            var visible = true;

            if (tipoFiltro && tipoRow !== tipoFiltro) {
                visible = false;
            }

            if (visible && dataInicial && (!dataRow || dataRow < dataInicial)) {
                visible = false;
            }

            if (visible && dataFinal && (!dataRow || dataRow > dataFinal)) {
                visible = false;
            }

            $row.toggle(visible);
        });
    }

    if ($table.length && window.jQuery && $.fn.DataTable) {
        extratoTable = $table.DataTable(window.buildDataTableOptions({
            paging: false,
            info: false,
            searching: false,
            responsive: true,
            order: [[0, "desc"]]
        }));

        $table.on("draw.dt", function () {
            applyExtratoFilter();
        });
    }

    $(document).on("submit", "#form-filtro-extrato", function (e) {
        e.preventDefault();
        applyExtratoFilter();
        return false;
    });

    $(document).on("click", "#btn-filtrar-extrato", function (e) {
        e.preventDefault();
        applyExtratoFilter();
        return false;
    });

    $(document).on("change", "#form-filtro-extrato select, #form-filtro-extrato input[type='date']", function () {
        applyExtratoFilter();
    });

    $(document).on("click", "#btn-limpar-filtro-extrato", function (e) {
        e.preventDefault();

        if (!$form.length) {
            return false;
        }

        $form[0].reset();
        applyExtratoFilter();

        return false;
    });

    $(document).on("click", ".btn-estornar-movimentacao", function () {
        var $button = $(this);

        $("#estorno_id_movimentacao").val($button.data("id") || "");
        $("#estorno_movimentacao_tipo").text($button.data("tipo") || "-");
        $("#estorno_movimentacao_valor").text($button.data("valor") || "-");
        $("#estorno_descricao").val("");
    });

    $.validator.addMethod('maxsaldo', function (value, element) {
        var max = parseFloat(element.getAttribute('data-max-saldo') || '0');
        var val = parseFloat(value.replace(/\./g, '').replace(',', '.')) || 0;
        return val <= max;
    }, function (params, element) {
        var max = parseFloat(element.getAttribute('data-max-saldo') || '0');
        return 'Saldo insuficiente. Disponível: R$ ' + max.toLocaleString('pt-BR', {
            minimumFractionDigits: 2, maximumFractionDigits: 2
        });
    });

    $.validator.addMethod('minrecarga', function (value, element) {
        var min = parseFloat(element.getAttribute('data-min-recarga') || '0');
        var val = parseFloat(String(value || '').replace(/\./g, '').replace(',', '.')) || 0;

        if (min <= 0) {
            return true;
        }

        return val >= min;
    }, function (params, element) {
        var min = parseFloat(element.getAttribute('data-min-recarga') || '0');
        return 'A recarga minima permitida e de R$ ' + min.toLocaleString('pt-BR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    });

    $('#recarga_valor').rules('add', { minrecarga: true });
    $('#consumo_valor').rules('add', { maxsaldo: true });
});
</script>
